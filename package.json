{
  "name": "medical-note-smart-on-fhir",
  "version": "0.48.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "packages:install": "node scripts/npm-with-github-packages.mjs install",
    "packages:ci": "node scripts/npm-with-github-packages.mjs ci",
    "dev": "next dev --turbopack -p 3001",
    "dev:cloud": "NEXT_PUBLIC_DEPLOYMENT_PROFILE=cloud NEXT_PUBLIC_OFFLINE_MODE=0 next dev --turbopack -p 3001",
    "dev:onprem": "NEXT_PUBLIC_DEPLOYMENT_PROFILE=onprem NEXT_PUBLIC_OFFLINE_MODE=1 next dev --turbopack -p 3100",
    "dev:webpack": "next dev",
    "build": "next build --turbopack",
    "build:cloud": "node scripts/build-cloud.mjs",
    "build:onprem": "node scripts/build-intranet.mjs",
    "audit:onprem": "node scripts/audit-onprem-artifact.mjs",
    "sanitize:onprem": "node scripts/sanitize-onprem-artifact.mjs",
    "package:onprem": "npm run build:onprem && node scripts/package-onprem.mjs",
    "start": "next start",
    "build:gh": "node scripts/build-gh.mjs",
    "build:mediprisma": "node scripts/build-mediprisma.mjs",
    "build:intranet": "node scripts/build-intranet.mjs",
    "build:demo": "node scripts/build-demo-bundle.mjs && node scripts/enrich-demo-bundle.mjs",
    "demo:enrich": "node scripts/enrich-demo-bundle.mjs",
    "deploy": "npm run build:gh && gh-pages -d out -b gh-pages",
    "test": "TZ=Asia/Taipei jest",
    "test:watch": "TZ=Asia/Taipei jest --watch",
    "test:coverage": "TZ=Asia/Taipei jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:emulated": "playwright test -c playwright.emulated.config.ts",
    "check:auth-domains": "node scripts/check-auth-domains.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "fix:lockfile": "node scripts/check-lockfile.mjs --fix",
    "validate:ips": "node scripts/validate-ips.mjs",
    "generate:ips-validation-fixture": "node scripts/generate-ips-validation-fixture.cjs",
    "bump:dep": "node scripts/bump-dep.mjs",
    "loop:gate": "node scripts/loop/gate.mjs",
    "loop:dashboard": "node scripts/loop/dashboard.mjs",
    "loop:log": "node scripts/loop/log.mjs",
    "eval:onprem-models": "node scripts/run-onprem-model-eval.mjs",
    "eval:onprem-patients": "node scripts/run-onprem-patient-eval.mjs",
    "eval:onprem-patient-summaries": "node scripts/run-onprem-patient-summary-eval.mjs",
    "audit:onprem-content": "node scripts/run-onprem-content-audit.mjs",
    "version": "node scripts/write-version.mjs && git add public/version.json",
    "lint": "eslint ."
  },
  "dependencies": {
